# TradingPro Market Data Service Configuration
# Copy this file to .env for local testing (Do NOT commit .env with secrets)

# Firebase Project ID
FIREBASE_PROJECT_ID=tradingpro-6c1ac

# Optional: Path to local Google Service Account Key JSON (for local dev only)
# On Cloud Run, Google Application Default Credentials (ADC) will be used automatically.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# Binance Market Data Worker Enable Flag
BINANCE_MARKET_DATA_ENABLED=true

# Binance WebSocket Base URL
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443/stream

# Firestore Write Throttling Interval (ms) per coin (Default: 1000ms = 1 update/sec max)
FIRESTORE_UPDATE_INTERVAL_MS=1000

# Seconds after last tick before data is marked stale
MARKET_DATA_STALE_AFTER_SECONDS=30

# Maximum WebSocket reconnection backoff delay (seconds)
MARKET_DATA_RECONNECTION_MAX_DELAY_SECONDS=30

# Periodic subscription refresh check interval (seconds)
SUBSCRIPTION_REFRESH_INTERVAL_SECONDS=30

# Port for Cloud Run healthcheck HTTP server
PORT=8080
