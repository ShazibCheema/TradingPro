rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'admin' || request.auth.token.role == 'superAdmin');
    }

    // Deposit Screenshots — accessible by submitting user and admins
    match /deposit-screenshots/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) 
        && request.resource.size < 20 * 1024 * 1024;
    }

    // Support Chat Attachments — accessible by authenticated users and guests
    match /support-attachments/{conversationId}/{allPaths=**} {
      allow read, write: if true
        && request.resource.size < 20 * 1024 * 1024;
    }

    // Coin Logos
    match /coin-logos/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Deposit Method QR Codes
    match /qr-codes/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
